  "font_size": 14,
  "html": "<div style=\"font-family: Arial, sans-serif; padding: 10px; max-width: 80mm;\">\n  <div style=\"text-align: center; border-bottom: 2px solid #000; padding-bottom: 8px;\">\n    <h2 style=\"margin: 0;\">AgriFlow Dealer</h2>\n    <p style=\"margin: 2px 0; font-size: 11px;\">Tiruvannamalai, Tamil Nadu</p>\n    <p style=\"margin: 2px 0; font-size: 11px;\">Cash & Carry Receipt | பணம் & எடுத்து செல்</p>\n  </div>\n\n  <div style=\"padding: 8px 0; font-size: 11px;\">\n    <table style=\"width: 100%;\">\n      <tr><td><strong>Invoice:</strong></td><td>{{ doc.name }}</td></tr>\n      <tr><td><strong>Date / தேதி:</strong></td><td>{{ doc.posting_date }}</td></tr>\n      <tr><td><strong>Time:</strong></td><td>{{ doc.posting_time }}</td></tr>\n      <tr><td><strong>Customer / வாடிக்கையாளர்:</strong></td><td>{{ doc.customer_name or doc.agriflow_walkin_customer_name or 'Walk-in' }}</td></tr>\n      {% if doc.agriflow_walkin_mobile %}<tr><td><strong>Mobile / மொபைல்:</strong></td><td>{{ doc.agriflow_walkin_mobile }}</td></tr>{% endif %}\n    </table>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; font-size: 11px;\">\n    <thead>\n      <tr style=\"border-bottom: 1px solid #000;\">\n        <th style=\"text-align: left; padding: 4px 2px;\">Item / பொருள்</th>\n        <th style=\"text-align: right; padding: 4px 2px;\">Qty</th>\n        <th style=\"text-align: right; padding: 4px 2px;\">Rate</th>\n        <th style=\"text-align: right; padding: 4px 2px;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr style=\"border-bottom: 1px dotted #ccc;\">\n        <td style=\"padding: 3px 2px;\">{{ item.item_name }}</td>\n        <td style=\"text-align: right; padding: 3px 2px;\">{{ item.qty }}</td>\n        <td style=\"text-align: right; padding: 3px 2px;\">{{ item.rate }}</td>\n        <td style=\"text-align: right; padding: 3px 2px;\">{{ item.amount }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"border-top: 2px solid #000; padding-top: 8px; margin-top: 8px;\">\n    <table style=\"width: 100%; font-size: 13px;\">\n      <tr>\n        <td><strong>Total / மொத்தம்:</strong></td>\n        <td style=\"text-align: right;\"><strong>{{ doc.get_formatted('grand_total') }}</strong></td>\n      </tr>\n      <tr>\n        <td><strong>Payment / கட்டணம்:</strong></td>\n        <td style=\"text-align: right;\">{{ doc.agriflow_payment_mode_extra or 'Cash' }}</td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"text-align: center; padding-top: 12px; font-size: 10px; border-top: 1px dotted #999; margin-top: 10px;\">\n    <p style=\"margin: 2px 0;\">Thank you! / நன்றி!</p>\n    <p style=\"margin: 2px 0;\">No returns after 7 days.</p>\n    <p style=\"margin: 2px 0;\">விசாரிக்க: 9876543210</p>\n  </div>\n</div>",
