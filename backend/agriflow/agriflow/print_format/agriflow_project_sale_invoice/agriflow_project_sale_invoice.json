  "font_size": 14,
  "html": "<div style=\"font-family: Arial, sans-serif; padding: 20px; max-width: 210mm;\">\n  <div style=\"text-align: center; border-bottom: 3px solid #2e7d32; padding-bottom: 12px;\">\n    <h1 style=\"margin: 0; color: #2e7d32;\">AgriFlow Subsidy Project Invoice</h1>\n    <h2 style=\"margin: 4px 0; color: #555; font-size: 16px;\">திட்ட விற்பனை பில்</h2>\n    <p style=\"margin: 4px 0; font-size: 12px;\">Tiruvannamalai, Tamil Nadu | Govt. Subsidy Dealer</p>\n  </div>\n\n  <div style=\"padding: 12px 0; display: flex; justify-content: space-between;\">\n    <div style=\"flex: 1;\">\n      <p style=\"margin: 4px 0;\"><strong>Invoice No. / பில் எண்:</strong> {{ doc.name }}</p>\n      <p style=\"margin: 4px 0;\"><strong>Date / தேதி:</strong> {{ doc.posting_date }}</p>\n      <p style=\"margin: 4px 0;\"><strong>Project / திட்டம்:</strong> {{ doc.agriflow_farmer_project }}</p>\n    </div>\n    <div style=\"flex: 1; text-align: right;\">\n      <p style=\"margin: 4px 0;\"><strong>Farmer / விவசாயி:</strong> {{ doc.customer_name }}</p>\n      <p style=\"margin: 4px 0;\"><strong>Mode / முறை:</strong> Project Sale / திட்ட விற்பனை</p>\n    </div>\n  </div>\n\n  <table style=\"width: 100%; border-collapse: collapse; margin-top: 12px;\">\n    <thead>\n      <tr style=\"background: #e8f5e9; border-bottom: 2px solid #2e7d32;\">\n        <th style=\"text-align: left; padding: 8px;\">Sl.</th>\n        <th style=\"text-align: left; padding: 8px;\">Item / பொருள்</th>\n        <th style=\"text-align: right; padding: 8px;\">Qty</th>\n        <th style=\"text-align: right; padding: 8px;\">Rate</th>\n        <th style=\"text-align: right; padding: 8px;\">Amount</th>\n      </tr>\n    </thead>\n    <tbody>\n      {% for item in doc.items %}\n      <tr style=\"border-bottom: 1px solid #ddd;\">\n        <td style=\"padding: 6px 8px;\">{{ loop.index }}</td>\n        <td style=\"padding: 6px 8px;\">{{ item.item_name }}<br><small style=\"color: #666;\">{{ item.item_code }}</small></td>\n        <td style=\"text-align: right; padding: 6px 8px;\">{{ item.qty }} {{ item.uom }}</td>\n        <td style=\"text-align: right; padding: 6px 8px;\">{{ item.rate }}</td>\n        <td style=\"text-align: right; padding: 6px 8px;\">{{ item.amount }}</td>\n      </tr>\n      {% endfor %}\n    </tbody>\n  </table>\n\n  <div style=\"margin-top: 20px; border: 2px solid #2e7d32; padding: 12px; background: #f1f8e9;\">\n    <h3 style=\"margin: 0 0 10px 0; color: #2e7d32;\">Subsidy Split / மானிய பிரிவு</h3>\n    <table style=\"width: 100%;\">\n      <tr>\n        <td style=\"padding: 4px 0;\">Total Amount / மொத்தம்:</td>\n        <td style=\"text-align: right; padding: 4px 0;\"><strong>{{ doc.get_formatted('grand_total') }}</strong></td>\n      </tr>\n      <tr>\n        <td style=\"padding: 4px 0; color: #2e7d32;\">Govt Subsidy (80%) / அரசு மானியம்:</td>\n        <td style=\"text-align: right; padding: 4px 0; color: #2e7d32;\"><strong>{{ doc.agriflow_subsidy_amount }}</strong></td>\n      </tr>\n      <tr>\n        <td style=\"padding: 4px 0; color: #d84315;\">Farmer Portion (20%) / விவசாயி பங்கு:</td>\n        <td style=\"text-align: right; padding: 4px 0; color: #d84315;\"><strong>{{ doc.agriflow_farmer_portion }}</strong></td>\n      </tr>\n    </table>\n  </div>\n\n  <div style=\"margin-top: 24px; display: flex; justify-content: space-between;\">\n    <div style=\"flex: 1;\">\n      <p style=\"margin: 4px 0; font-size: 11px;\"><strong>Terms / நிபந்தனைகள்:</strong></p>\n      <ul style=\"font-size: 11px; padding-left: 20px;\">\n        <li>Subsidy subject to MIMIS approval</li>\n        <li>Installation within 30 days</li>\n        <li>3-year warranty on materials</li>\n      </ul>\n    </div>\n    <div style=\"flex: 1; text-align: right; margin-top: 40px;\">\n      <p style=\"margin: 4px 0; border-top: 1px solid #333; padding-top: 4px; display: inline-block; width: 200px;\">Authorized Signature</p>\n      <br>\n      <p style=\"margin: 4px 0; font-size: 11px;\">அங்கீகரிக்கப்பட்ட கையொப்பம்</p>\n    </div>\n  </div>\n\n  <div style=\"text-align: center; padding-top: 16px; margin-top: 20px; border-top: 1px dotted #999; font-size: 10px; color: #666;\">\n    <p>This is a computer-generated invoice. | கணினியில் தயாரிக்கப்பட்ட பில்.</p>\n  </div>\n</div>",
